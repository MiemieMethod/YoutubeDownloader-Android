<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Cogwheel" Version="2.1.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Gress" Version="2.2.0" />
    <PackageVersion Include="JsonExtensions" Version="1.2.3" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageVersion Include="PowerKit" Version="2.4.0" />
    <PackageVersion Include="TagLibSharp" Version="2.3.0" />
    <PackageVersion Include="YoutubeExplode" Version="6.6.2" />
    <PackageVersion Include="YoutubeExplode.Converter" Version="6.6.2" />
  </ItemGroup>
</Project>
